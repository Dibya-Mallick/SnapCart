# Copy to .env in the repo root. Both the backend and the frontend read it.

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sandbox client ID (public). Enables the PayPal buttons.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- PayPal (server side, sandbox) ---------------------------------------------
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- AI via Groq ----------------------------------------------------------------
# One key powers both the shopping agent (tool calling) and menu reading (vision).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# "groq" or "none" (deterministic rule-based planner, no key needed)
LLM_PROVIDER=groq
# "groq", "gemini", or "mock" (fixed demo menu, no key needed)
VISION_PROVIDER=groq
# Only for VISION_PROVIDER=gemini
VISION_API_KEY=
VISION_MODEL=

# --- App ------------------------------------------------------------------------
# Where shoppers open checkout links that external agents hand them.
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
# DATABASE_URL and UPLOAD_DIRECTORY default to files inside backend/.
